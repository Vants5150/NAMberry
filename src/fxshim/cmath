// minimal cmath for Circle (-nostdinc++): the std:: functions used by the ADEL engines, built on fxmath
#ifndef _fxshim_cmath
#define _fxshim_cmath

#include "fxmath.h"

#ifndef M_PI
#define M_PI		3.14159265358979323846
#endif
#ifndef M_LN2
#define M_LN2		0.69314718055994530942
#endif

namespace std {

#define FXS_FD(name, fn)	inline double name (double x) { return fxm::fn (x); } \
				inline float name (float x) { return (float) fxm::fn ((double) x); } \
				inline double name (int x) { return fxm::fn ((double) x); } \
				inline double name (long x) { return fxm::fn ((double) x); } \
				inline double name (unsigned x) { return fxm::fn ((double) x); } \
				inline double name (unsigned long x) { return fxm::fn ((double) x); }

FXS_FD (exp, exp)
FXS_FD (exp2, exp2)
FXS_FD (log, log)
FXS_FD (log2, log2)
FXS_FD (log10, log10)
FXS_FD (log1p, log1p)
FXS_FD (sin, sin)
FXS_FD (cos, cos)
FXS_FD (tan, tan)
FXS_FD (atan, atan)
FXS_FD (tanh, tanh)
#undef FXS_FD

inline double pow (double x, double y) { return fxm::pow (x, y); }
inline float pow (float x, float y) { return (float) fxm::pow ((double) x, (double) y); }
inline double pow (double x, int y) { return fxm::pow (x, (double) y); }
inline float pow (float x, int y) { return (float) fxm::pow ((double) x, (double) y); }
inline double atan2 (double y, double x) { return fxm::atan2 (y, x); }
inline double fmod (double x, double y) { return fxm::fmod (x, y); }
inline float fmod (float x, float y) { return (float) fxm::fmod ((double) x, (double) y); }
inline float atan2 (float y, float x) { return (float) fxm::atan2 ((double) y, (double) x); }

inline double sqrt (double x) { return __builtin_sqrt (x); }
inline float sqrt (float x) { return __builtin_sqrtf (x); }
inline double sqrt (int x) { return __builtin_sqrt ((double) x); }
inline double fabs (double x) { return __builtin_fabs (x); }
inline float fabs (float x) { return __builtin_fabsf (x); }
inline double abs (double x) { return __builtin_fabs (x); }
inline float abs (float x) { return __builtin_fabsf (x); }
inline int abs (int x) { return x < 0 ? -x : x; }
inline long abs (long x) { return x < 0 ? -x : x; }
inline double floor (double x) { return __builtin_floor (x); }
inline float floor (float x) { return __builtin_floorf (x); }
inline double ceil (double x) { return __builtin_ceil (x); }
inline float ceil (float x) { return __builtin_ceilf (x); }
inline long lround (double x) { return (long) (x + (x >= 0.0 ? 0.5 : -0.5)); }
inline long lround (float x) { return (long) (x + (x >= 0.0f ? 0.5f : -0.5f)); }
inline bool isfinite (double x) { return x - x == 0.0; }
inline bool isnan (double x) { return x != x; }

}

#endif
