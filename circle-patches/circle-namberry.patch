diff --git a/lib/exceptionstub64.S b/lib/exceptionstub64.S
index 746f83e..895d4b3 100644
--- a/lib/exceptionstub64.S
+++ b/lib/exceptionstub64.S
@@ -87,7 +87,68 @@ VectorTable:
  * Abort stubs
  */
 	stub	UnexpectedStub,		EXCEPTION_UNEXPECTED
-	stub	SynchronousStub,	EXCEPTION_SYNCHRONOUS
+	stub	SyncNormalStub,	EXCEPTION_SYNCHRONOUS
+
+/*
+ * Synchronous exceptions: EC 0 with a good word in memory is a bad instruction fetch, which is retried (see patch_circle_stub.py)
+ */
+	.globl	SynchronousStub
+SynchronousStub:
+	stp	x0, x1, [sp, #-16]!
+	mrs	x0, esr_el1
+	lsr	x0, x0, #26
+	cbnz	x0, 9f				/* only EC 0 (unknown reason) */
+	stp	x2, x3, [sp, #-16]!
+	mrs	x2, elr_el1
+	bic	x0, x2, #63
+	dc	civac, x0				/* drop the line from the data caches, reread from DRAM */
+	dsb	sy
+	ldr	w1, [x2]
+	cbz	w1, 8f				/* really zero in memory: not recoverable */
+	ldr	x3, =ExcRetryPc
+	ldr	x0, [x3]
+	cmp	x0, x2
+	b.ne	7f
+	ldr	x3, =ExcRetryCnt
+	ldr	x0, [x3]
+	cmp	x0, #20
+	b.hs	8f				/* same pc failed again and again */
+	add	x0, x0, #1
+	str	x0, [x3]
+	b	6f
+7:	ldr	x3, =ExcRetryPc
+	str	x2, [x3]
+	ldr	x3, =ExcRetryCnt
+	str	xzr, [x3]
+6:	ldr	x3, =ExcRetryTotal
+	ldr	x0, [x3]
+	add	x0, x0, #1
+	str	x0, [x3]
+	mov	x0, #20000
+5:	sub	x0, x0, #1
+	cbnz	x0, 5b				/* pause of some microseconds: a transient condition may pass */
+	bic	x0, x2, #63
+	dc	civac, x0
+	dsb	sy
+	ic	ialluis				/* instruction caches (all cores' inner shareable domain) */
+	dsb	ish
+	isb
+	ldp	x2, x3, [sp], #16
+	ldp	x0, x1, [sp], #16
+	eret
+8:	ldp	x2, x3, [sp], #16
+9:	ldp	x0, x1, [sp], #16
+	b	SyncNormalStub
+
+	.ltorg
+
+	.data
+	.align	3
+	.globl	ExcRetryTotal
+ExcRetryTotal:	.quad	0
+ExcRetryPc:	.quad	0
+ExcRetryCnt:	.quad	0
+	.text
 	stub	SErrorStub,		EXCEPTION_SYSTEM_ERROR
 
