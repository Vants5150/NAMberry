 #define	COMP2_RX_WORDSIZE_0(r)	(((r) & GENMASK(2, 0)) >> 0)
 
+// DMA buffer: start and end on 64-byte cache lines, no other object on the same lines
+static u32 *AllocDMABuffer (unsigned nWords)
+{
+	size_t nBytes = (((size_t) nWords * sizeof (u32)) + 63) & ~(size_t) 63;
+	u8 *pRaw = new u8[nBytes + 64 + 64];
+	uintptr ulAligned = ((uintptr) pRaw + sizeof (u8 *) + 63) & ~(uintptr) 63;
+	((u8 **) ulAligned)[-1] = pRaw;
+	return (u32 *) ulAligned;
+}
+
+static void FreeDMABuffer (u32 *pBuffer)
+{
+	if (pBuffer)
+	{
+		delete [] ((u8 **) pBuffer)[-1];
+	}
+}
